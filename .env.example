# Database Connection (SQLite default for dev; PostgreSQL/MySQL supported by Prisma for production)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Generate a strong 32+ character random string for production)
JWT_SECRET="your_production_jwt_secret_key_here"

# Application Base URL (Used for Sitemap and Canonical URLs)
NEXT_PUBLIC_APP_URL="https://tradex.local"

# Google Maps Platform API Key
# Maps JavaScript API (Client-side)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
# Places API (Server-side proxy)
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
